{
  "name": "sistema-control-inventario",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "check:palette": "node scripts/check-palette.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "prebuild": "npm run check:palette && npm run check:contrast",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:visual": "node scripts/visual-check.mjs",
    "audit:mobile": "node scripts/mobile-audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "playwright-core": "^1.56.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4"
  }
}
